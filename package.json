{
  "name": "dsh-ascii-sharks",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "ZZJ (平躺の仙人)",
  "description": "ASCII Sharks as a DeepSeek Harness background (二次开发版): the original ascii-sharks canvas behind the Web UI, with a stage-aware mask, a frame-rate cap and a clean uninstall.",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
